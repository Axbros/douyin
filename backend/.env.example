DATABASE_URL=mysql+asyncmy://root:CHANGE_ME@127.0.0.1:3306/douyin?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
JWT_EXPIRE_MINUTES=60
STORAGE_STATE_ENCRYPTION_KEY=CHANGE_ME

# 本地一键启动和 Linux 部署时创建的任务 Worker 数量。
TASK_WORKER_PROCESSES=2

# Linux 无桌面服务器保持 false，由 Xvfb 提供虚拟屏幕。
PLAYWRIGHT_HEADLESS=false
