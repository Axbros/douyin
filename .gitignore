# ===== 敏感文件（绝不推送）=====
config.yaml
cookies.json
dev_doc.md
app.log

# ===== 运行时缓存 =====
.workbuddy/
.trae/
*.log
.runtime/

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg

# ===== 打包产物 =====
# 安装包（>100MB）通过 GitHub Releases 发布，不进 git 仓库
build/
dist/

# ===== 虚拟环境 =====
venv/
.venv/
env/

# ===== IDE =====
.idea/
.vscode/
*.swp
*.swo

# ===== 系统文件 =====
.DS_Store
Thumbs.db

# ===== 模型缓存 =====
*.pt
models/

# ===== 临时/杂项文件 =====
*.tmp
*.bak
*.lnk
src/*.svg

# Backend secrets and local environment
backend/.env
backend/.env.*
!backend/.env.example
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
backend/playwright-report/
backend/test-results/
backend/storage/
backend/browser-data/

# Local databases and credentials
*.sqlite
*.sqlite3
*.db
*.pem

# Frontend
node_modules/
frontend/dist/
frontend/.vite/
frontend/.env
frontend/.env.*
!frontend/.env.example
*.tsbuildinfo

# ===== 抓包报告（含敏感请求信息）=====
douyin_capture_report.txt
douyin_like_verify_report.txt
like_capture_report.txt
like_verify*.txt

# ===== 反编译/APK 分析产物（体积大，不进仓库）=====
.dbg/
快手极速最新安装包*/
*_apk_output/

# ===== 安装包（本地编译产物）=====
*.exe
