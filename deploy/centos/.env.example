# 只复制为 .env 后填写真实值；不要把 .env 提交到 Git。
COMPOSE_PROJECT_NAME=douyin
PUBLIC_PORT=80
TZ=Asia/Shanghai

MYSQL_DATABASE=douyin
MYSQL_USER=douyin_app
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_PASSWORD=CHANGE_ME_APP_PASSWORD
# 密码若含 @、:、/、?、#、% 等字符，必须先做 URL 编码再写入下方地址。
DATABASE_URL=mysql+asyncmy://douyin_app:CHANGE_ME_APP_PASSWORD@mysql:3306/douyin?charset=utf8mb4

REDIS_URL=redis://redis:6379/0
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
JWT_EXPIRE_MINUTES=60
STORAGE_STATE_ENCRYPTION_KEY=CHANGE_ME_TO_A_FERNET_KEY

# 浏览器在 Xvfb 虚拟屏幕中以有界面模式运行，服务器不需要安装桌面。
PLAYWRIGHT_HEADLESS=false
TASK_WORKER_PROCESSES=2
