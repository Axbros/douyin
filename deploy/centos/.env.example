# 只复制为 .env 后填写真实值；不要把 .env 提交到 Git。
COMPOSE_PROJECT_NAME=douyin
PUBLIC_PORT=80
TZ=Asia/Shanghai

MYSQL_DATABASE=douyin
MYSQL_USER=douyin_app
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_PASSWORD=CHANGE_ME_APP_PASSWORD
# 密码若含 @、:、/、?、#、% 等字符，必须先做 URL 编码再写入下方地址。
DATABASE_URL=mysql+asyncmy://douyin_app:CHANGE_ME_APP_PASSWORD@mysql:3306/douyin?charset=utf8mb4

REDIS_URL=redis://redis:6379/0
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
JWT_EXPIRE_MINUTES=60
STORAGE_STATE_ENCRYPTION_KEY=CHANGE_ME_TO_A_FERNET_KEY

# 浏览器在 Xvfb 虚拟屏幕中以有界面模式运行，服务器不需要安装桌面。
PLAYWRIGHT_HEADLESS=false
TASK_WORKER_PROCESSES=2

# 中国大陆构建镜像。需要时可换成自己的 ACR、TCR 或其他可信镜像。
PYTHON_BASE_IMAGE=python:3.12-slim-bookworm
PLAYWRIGHT_VERSION=1.62.0
NODE_BASE_IMAGE=node:24-alpine
NGINX_BASE_IMAGE=nginx:1.28-alpine
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:7.4-alpine
DEBIAN_MIRROR=https://mirrors.aliyun.com/debian
DEBIAN_SECURITY_MIRROR=https://mirrors.aliyun.com/debian-security
PYPI_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
NPM_REGISTRY=https://registry.npmmirror.com
PLAYWRIGHT_DOWNLOAD_HOST=https://cdn.npmmirror.com/binaries/playwright
PLAYWRIGHT_DOWNLOAD_CONNECTION_TIMEOUT=120000
