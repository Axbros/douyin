[Unit]
Description=Douyin Task Worker %i
After=network-online.target douyin-api.service
Wants=network-online.target

[Service]
Type=simple
User=douyin
Group=douyin
WorkingDirectory=/opt/douyin
EnvironmentFile=/opt/douyin/backend/.env
Environment=PYTHONPATH=/opt/douyin/backend:/opt/douyin
Environment=PLAYWRIGHT_HEADLESS=false
Environment=WORKER_INSTANCE_ID=%i
ExecStart=/usr/bin/xvfb-run -a -s "-screen 0 1280x900x24 -nolisten tcp" /opt/douyin/backend/.venv/bin/python /opt/douyin/backend/workers/task_worker.py
Restart=always
RestartSec=3
TimeoutStopSec=45
KillMode=control-group
LogsDirectory=douyin
StandardOutput=append:/var/log/douyin/task-worker-%i.log
StandardError=append:/var/log/douyin/task-worker-%i.log

[Install]
WantedBy=multi-user.target
